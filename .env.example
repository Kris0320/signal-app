# Meetup OAuth2 credentials (server-to-server / signed-JWT flow).
# See README.md → "Connecting Meetup" for the one-time setup.

# Your OAuth consumer client key, from secure.meetup.com/meetup_api
MEETUP_CLIENT_ID=

# The "kid" (signing key id) assigned when you uploaded your public RSA key
MEETUP_SIGNING_KEY_ID=

# Your own Meetup member id (numeric). Used as the "sub" claim in the JWT.
# Find it at secure.meetup.com/meetup_api/key/ once signed in.
MEETUP_MEMBER_ID=

# Path to your local PKCS#8 private key (matching the public key you uploaded)
MEETUP_PRIVATE_KEY_PATH=./meetup-private.pem
